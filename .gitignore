# dependencies
node_modules/
.pnpm-store/

# next.js
.next/
out/
next-env.d.ts

# build output
dist/
build/
*.tsbuildinfo

# android / capacitor
# NOTE: apps/web/android IS committed. AndroidManifest.xml carries our
# permissions (HIGH_SAMPLING_RATE_SENSORS et al); regenerating the project
# with `cap add android` would silently drop them. Only build output and
# machine-specific files are ignored.
apps/web/android/build/
apps/web/android/app/build/
apps/web/android/.gradle/
apps/web/android/local.properties
apps/web/android/app/src/main/assets/public/
apps/web/android/app/src/main/assets/capacitor.config.json
apps/web/android/app/src/main/res/xml/config.xml
ios/
*.apk
*.aab

# env
.env
.env.local
.env*.local

# python / ml
__pycache__/
*.py[cod]
.venv/
venv/
ml/data/raw/
ml/checkpoints/
*.pth
*.onnx
# ...but the Phase 8 speed model is 35 KB and is the interoperable artefact
# ml/README.md points at, so it is worth having in the repository.
!ml/export/*.onnx
*.tflite

# large map data (regenerate with scripts/build-road-graph.mjs)
data/maps/*.pmtiles
data/maps/*.osm.pbf

# os / editor
.DS_Store
# macOS / iCloud duplication artifacts ("file 2.xml"). A space in a filename
# breaks Android's resource merger outright — `config 2.xml` failed the APK
# build once already.
* [0-9].*
*\ [0-9].*
.idea/
.vscode/
*.swp

# logs
*.log
npm-debug.log*
pnpm-debug.log*
coverage/

# ...except the one published to the website. Render builds the site but has
# no Android SDK, so it cannot produce an APK — if the download button is to
# work on the deployed site, that one file has to be committed.
#
# Tradeoff, stated: git keeps every version, so this grows the repo by ~6 MB
# per published build. If that becomes a problem the right home is GitHub
# Releases, and only components/DownloadApk.tsx needs to change.
!apps/web/public/downloads/*.apk
ml/data/raw/
ml/data/processed/
ml/.venv/
