  "main": "./src/index.ts",
  "scripts": {
    "eval": "tsx src/cli.ts",
    "ablation": "tsx src/ablation.ts",
    "alignment": "tsx src/alignment.ts",
    "offroad": "tsx src/offroad.ts",
    "drift-dataset": "tsx src/drift-dataset.ts",
    "gnss-dataset": "tsx src/gnss-quality-dataset.ts",
    "record": "tsx src/record.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "tier-r": "tsx src/tierR.ts",
    "trail": "tsx src/trailreport.ts"
  },
  "dependencies": {
    "@pathpulse/nav-core": "workspace:*",
    "@pathpulse/sensor-sources": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
