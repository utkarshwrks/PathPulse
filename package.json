{
  "name": "pathpulse",
  "version": "0.1.0",
  "private": true,
  "description": "AI-ML based Intelligent Dead Reckoning system for seamless navigation (SIH26168, ISRO)",
  "scripts": {
    "dev": "pnpm --filter @pathpulse/web dev",
    "build": "pnpm --filter @pathpulse/web build",
    "start": "pnpm --filter @pathpulse/web start",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @pathpulse/nav-core test:watch",
    "typecheck": "pnpm -r typecheck",
    "lint:core-purity": "node scripts/check-core-purity.mjs",
    "dev:lan": "pnpm --filter @pathpulse/web dev:lan",
    "dev:https": "pnpm --filter @pathpulse/web dev:https",
    "build:android": "pnpm --filter @pathpulse/web build:android && node scripts/apk-path.mjs",
    "cap:sync": "pnpm --filter @pathpulse/web cap:sync",
    "eval": "pnpm --filter @pathpulse/eval eval",
    "ablation": "pnpm --filter @pathpulse/eval ablation",
    "eval:record": "pnpm --filter @pathpulse/eval record",
    "demo:log": "node scripts/make-demo-log.mjs",
    "demo:brief": "node scripts/make-offline-brief.mjs"
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9"
  }
}
